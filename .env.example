# API keys (BYOK — calls are routed through the user's own keys, nothing proxied)
# Copy to .env and fill in what you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Laya router (laya-serve on your server, reached via SSH tunnel / Tailscale).
# Required unless --classifier heuristic.
LAYA_URL=http://localhost:8000
LAYA_API_KEY=
# Optional: checkpoint name (default typed-decisions = convaiinnovations/laya-typed-decisions)
LAYA_MODEL=
# Optional: prompts longer than this skip the router and go to the flagship (default 6000)
LAYA_MAX_CHARS=
